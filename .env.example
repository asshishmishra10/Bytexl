# ==============================================================================
# Aegis — Digital Risk Protection Environment Configuration
# ==============================================================================

# Backend / API Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Database (Optional: Provide Supabase/PostgreSQL connection string; defaults to local aegis.db)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# Frontend Environment Variables (prefix with VITE_ for Vite build)
VITE_API_BASE=
VITE_SUPABASE_PROJECT_REF=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Threat Intelligence API Keys (Optional — local ML fallback works automatically)
