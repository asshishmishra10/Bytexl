# ==============================================================================
# Aegis Backend Environment Configuration
# ==============================================================================

# Server settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Threat Intelligence Feed Keys (Optional corroboration feeds)
# ------------------------------------------------------------------------------

# AbuseIPDB API Key (1,000 queries/day free)
# Register: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# Google Safe Browsing API v4 Key (10,000 queries/day free)
# Register: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# AlienVault OTX Key (Unlimited community pulses)
# Register: https://otx.alienvault.com
ALIENVAULT_OTX_KEY=

# VirusTotal v3 Key (500 queries/day free)
# Register: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# GitHub Personal Access Token (5,000 requests/hour free)
# Register: https://github.com/settings/tokens
GITHUB_PAT=
